name: .NET
on: 
  push:
    branches: [master]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-versions: '8.0.x'
      - name: Run application
        run: dotnet run --project PR10.csprojss